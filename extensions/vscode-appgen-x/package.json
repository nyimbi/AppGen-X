{
  "name": "appgen-x-vscode",
  "displayName": "AppGen-X",
  "description": "Language tooling for AppGen-X DSL files.",
  "version": "0.1.0",
  "publisher": "appgen-x",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:appgen",
    "onCommand:appgen.lint",
    "onCommand:appgen.semantic",
    "onCommand:appgen.previewSemantic",
    "onCommand:appgen.validate",
    "onCommand:appgen.format",
    "onCommand:appgen.graph",
    "onCommand:appgen.previewGraph",
    "onCommand:appgen.previewDesigner",
    "onCommand:appgen.migrationPlan",
    "onCommand:appgen.nlPlan",
    "onCommand:appgen.agentHandoff",
    "onCommand:appgen.explain",
    "onCommand:appgen.generate",
    "onCommand:appgen.previewArtifacts",
    "onCommand:appgen.verifyRelease",
    "onCommand:appgen.package",
    "onCommand:appgen.doctor",
    "onCommand:appgen.toolingAudit",
    "onCommand:appgen.contractSchema",
    "onCommand:appgen.validateContract",
    "onCommand:appgen.pbcCatalog",
    "onCommand:appgen.restartLanguageServer",
    "onView:appgen.workspace",
    "onView:appgen.reports",
    "onView:appgen.agents"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "appgen",
        "aliases": [
          "AppGen-X",
          "appgen"
        ],
        "extensions": [
          ".appgen",
          ".ag",
          ".ags"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "appgen",
        "scopeName": "source.appgen",
        "path": "./syntaxes/appgen.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "AppGen-X",
      "properties": {
        "appgen.command": {
          "type": "string",
          "default": "appgen",
          "description": "Command used to run the AppGen-X CLI and language server."
        }
      }
    },
    "commands": [
      {
        "command": "appgen.lint",
        "title": "AppGen-X: Lint Current File"
      },
      {
        "command": "appgen.semantic",
        "title": "AppGen-X: Show Semantic Model JSON"
      },
      {
        "command": "appgen.previewSemantic",
        "title": "AppGen-X: Preview Semantic Model"
      },
      {
        "command": "appgen.validate",
        "title": "AppGen-X: Validate Current File"
      },
      {
        "command": "appgen.format",
        "title": "AppGen-X: Format Current File"
      },
      {
        "command": "appgen.graph",
        "title": "AppGen-X: Show Graph JSON"
      },
      {
        "command": "appgen.previewGraph",
        "title": "AppGen-X: Preview Graphs"
      },
      {
        "command": "appgen.previewDesigner",
        "title": "AppGen-X: Preview Designer Sync"
      },
      {
        "command": "appgen.migrationPlan",
        "title": "AppGen-X: Create Migration Plan"
      },
      {
        "command": "appgen.nlPlan",
        "title": "AppGen-X: Plan Natural Language Change"
      },
      {
        "command": "appgen.agentHandoff",
        "title": "AppGen-X: Prepare Coding Agent Handoff"
      },
      {
        "command": "appgen.explain",
        "title": "AppGen-X: Explain Symbol"
      },
      {
        "command": "appgen.generate",
        "title": "AppGen-X: Generate Application"
      },
      {
        "command": "appgen.previewArtifacts",
        "title": "AppGen-X: Preview Generated Artifacts"
      },
      {
        "command": "appgen.verifyRelease",
        "title": "AppGen-X: Verify Release Targets"
      },
      {
        "command": "appgen.package",
        "title": "AppGen-X: Package Application"
      },
      {
        "command": "appgen.doctor",
        "title": "AppGen-X: Run Doctor"
      },
      {
        "command": "appgen.toolingAudit",
        "title": "AppGen-X: Run Tooling Audit"
      },
      {
        "command": "appgen.contractSchema",
        "title": "AppGen-X: Browse Contract Schemas"
      },
      {
        "command": "appgen.validateContract",
        "title": "AppGen-X: Validate Semantic Contract"
      },
      {
        "command": "appgen.pbcCatalog",
        "title": "AppGen-X: Browse PBC Catalog"
      },
      {
        "command": "appgen.restartLanguageServer",
        "title": "AppGen-X: Restart Language Server"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "appgen.lint"
        },
        {
          "command": "appgen.semantic"
        },
        {
          "command": "appgen.previewSemantic"
        },
        {
          "command": "appgen.validate"
        },
        {
          "command": "appgen.format"
        },
        {
          "command": "appgen.graph"
        },
        {
          "command": "appgen.previewGraph"
        },
        {
          "command": "appgen.previewDesigner"
        },
        {
          "command": "appgen.migrationPlan"
        },
        {
          "command": "appgen.nlPlan"
        },
        {
          "command": "appgen.agentHandoff"
        },
        {
          "command": "appgen.explain"
        },
        {
          "command": "appgen.generate"
        },
        {
          "command": "appgen.previewArtifacts"
        },
        {
          "command": "appgen.verifyRelease"
        },
        {
          "command": "appgen.package"
        },
        {
          "command": "appgen.doctor"
        },
        {
          "command": "appgen.toolingAudit"
        },
        {
          "command": "appgen.contractSchema"
        },
        {
          "command": "appgen.validateContract"
        },
        {
          "command": "appgen.pbcCatalog"
        },
        {
          "command": "appgen.restartLanguageServer"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "appgen-x",
          "title": "AppGen-X",
          "icon": "resources/appgen.svg"
        }
      ]
    },
    "views": {
      "appgen-x": [
        {
          "id": "appgen.workspace",
          "name": "Workspace"
        },
        {
          "id": "appgen.reports",
          "name": "Reports"
        },
        {
          "id": "appgen.agents",
          "name": "Agent Handoffs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "appgen.workspace",
        "contents": "Open an AppGen-X DSL file, then run validation, designer sync, graph, generation, or packaging actions from this view."
      },
      {
        "view": "appgen.reports",
        "contents": "Run Doctor or Tooling Audit for machine-readable release evidence."
      },
      {
        "view": "appgen.agents",
        "contents": "Use Natural Language Plan or Coding Agent Handoff to produce compact handoffs for coding agents and local models."
      }
    ]
  }
}
