{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@appgen/ui-kit": ["app/ui_kit/index.ts"],
      "@appgen/ui-kit/components.css": ["app/ui_kit/components.css"]
    }
  },
  "include": ["src", "app/ui_kit", "vite.config.ts"]
}
